generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Role {
  ADMIN
  FIGHTER
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now())
}

model Event {
  id             String      @id @default(cuid())
  title          String
  opponent       String?
  eventDate      DateTime
  location       String
  description    String?
  ticketLink     String?
  posterImageUrl String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  media          MediaItem[]
}

model MediaItem {
  id        String    @id @default(cuid())
  url       String
  filename  String
  type      MediaType
  caption   String?
  eventId   String?
  event     Event?    @relation(fields: [eventId], references: [id])
  createdAt DateTime  @default(now())
}

enum MediaType {
  IMAGE
  VIDEO
}

model Coach {
  id        String   @id @default(cuid())
  name      String
  role      String
  bio       String
  photoUrl  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ScheduleClass {
  id        String   @id @default(cuid())
  dayOfWeek Int
  time      String
  className String
  coachName String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Fighter {
  id          String   @id @default(cuid())
  name        String
  weightClass String
  wins        Int      @default(0)
  losses      Int      @default(0)
  draws       Int      @default(0)
  kos         Int      @default(0)
  bio         String
  photoUrl    String?
  sortOrder   Int      @default(0)
  userId      String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Page {
  id        String   @id @default(cuid())
  slug      String   @unique
  title     String
  body      String
  photoUrl  String?
  published Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
